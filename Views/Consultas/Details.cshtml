@model Consulta
@{
    ViewData["Title"] = "Detalhes da consulta";
    var futura = Model.DataHora >= DateTime.Now;
}

<section class="page-section">
    <div class="container narrow-container">
        <a class="back-link" asp-action="Index">← Voltar para consultas</a>

        <article class="details-card">
            <div class="details-header">
                <div>
                    <span class="appointment-status @(futura ? "" : "status-past")">@(futura ? "Agendada" : "Realizada")</span>
                    <h1>@Model.Especialidade</h1>
                </div>
                <div class="details-date">
                    <strong>@Model.DataHora.ToString("dd/MM/yyyy")</strong>
                    <span>@Model.DataHora.ToString("HH:mm")</span>
                </div>
            </div>

            <div class="details-section">
                <span>Descrição</span>
                <p>@Model.Descricao</p>
            </div>

            <div class="details-actions">
                @if (futura)
                {
                    <a class="button button-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar consulta</a>
                }
                <a class="button button-danger-outline" asp-action="Delete" asp-route-id="@Model.Id">Excluir</a>
            </div>
        </article>
    </div>
</section>
