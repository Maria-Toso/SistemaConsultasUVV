@model Consulta
@{
    ViewData["Title"] = "Excluir consulta";
}

<section class="page-section">
    <div class="container narrow-container">
        <a class="back-link" asp-action="Index">← Voltar para consultas</a>

        <article class="delete-card">
            <div class="danger-mark" aria-hidden="true">!</div>
            <span class="eyebrow danger-text">Ação permanente</span>
            <h1>Excluir esta consulta?</h1>
            <p>O registro será removido do sistema e não poderá ser recuperado.</p>

            <div class="delete-summary">
                <div>
                    <span>Especialidade</span>
                    <strong>@Model.Especialidade</strong>
                </div>
                <div>
                    <span>Data e hora</span>
                    <strong>@Model.DataHora.ToString("dd/MM/yyyy 'às' HH:mm")</strong>
                </div>
            </div>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="details-actions">
                <a class="button button-secondary" asp-action="Index">Cancelar</a>
                <button class="button button-danger" type="submit">Sim, excluir consulta</button>
            </form>
        </article>
    </div>
</section>
