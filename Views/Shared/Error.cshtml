@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

<section class="page-section">
    <div class="container narrow-container">
        <div class="empty-state">
            <div class="status-code">500</div>
            <h1>Algo não saiu como esperado</h1>
            <p>Não foi possível concluir a operação. Tente novamente em alguns instantes.</p>
            @if (Model.ShowRequestId)
            {
                <p class="technical-info">Identificador da solicitação: <code>@Model.RequestId</code></p>
            }
            <a class="button button-primary" asp-controller="Home" asp-action="Index">Voltar ao início</a>
        </div>
    </div>
</section>
